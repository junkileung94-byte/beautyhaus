# Beauty Extension Haus — booking webhook receiver secrets.
# Copy to deploy/hooks.env (gitignored) and fill in, then:
#   docker compose -f deploy/docker-compose.yml up -d --force-recreate hooks
#
# Without these the endpoints reject every delivery with 401 — that is the
# intended state until the webhooks are actually set up.

# Square (Barrie / CA bookings)
#   Square Developer dashboard -> your application -> Webhooks -> Subscriptions
#   Add subscription:
#     URL     https://beautyextensionhaus.com/api/hook/square
#     Events  booking.created, booking.updated
#   Then copy the subscription's "Signature key" here. It is NOT the access token.
SQUARE_SIGNATURE_KEY=

# Must match the subscription URL character for character — Square signs
# (notification_url + body), so a trailing slash difference breaks verification.
SQUARE_NOTIFICATION_URL=https://beautyextensionhaus.com/api/hook/square

# Mangomint (Sarasota / US bookings)
#   Webhooks are a paid add-on on Standard/Unlimited and are configured by
#   Mangomint support, not self-serve. Ask them to POST "Appointment booked",
#   "Appointment canceled" and "Sale completed" to:
#     https://beautyextensionhaus.com/api/hook/mangomint?key=<the secret below>
#   Generate one with: openssl rand -hex 24
MANGOMINT_SECRET=
